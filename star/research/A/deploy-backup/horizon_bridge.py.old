#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Read-only bridge from Horizon's inbox to the shared event bus.

The bridge never writes to Horizon's database or directory.  It appends
idea/idea_edit/idea_drop lines to events-horizon.jsonl and writes a small
horizon-today.json snapshot, using only the Python standard library.
"""

import argparse
import contextlib
import hashlib
import json
import os
import pathlib
import sqlite3
import sys
import time
from datetime import datetime, timedelta, timezone

try:
    import fcntl
except ImportError:  # Windows: tests still run, just without a file lock.
    fcntl = None


DEFAULT_DB = "/home/max237/horizon/data/horizon.db"
DEFAULT_EVENTS_DIR = "/mnt/d/Claude Code 工作区/knowledge/Agent-Shared/home"
DEFAULT_STATE_DIR = "~/.local/state/horizon-star-bridge"
EVENTS_NAME = "events-horizon.jsonl"
TODAY_NAME = "horizon-today.json"
MAX_EVENTS = 200
MAX_TEXT = 2000
LOCAL8 = timezone(timedelta(hours=8))
UTC = timezone.utc
TODAY_REFRESH_SECONDS = 30 * 60
LOG_MAX_BYTES = 1 * 1024 * 1024
ACTIVE_STATUSES = ("pending", "doing", "needs_review")
FLAG_RANK = {"overdue": 0, "today": 1, "p0_floating": 2}
PRIORITY_RANK = {"P0": 0, "P1": 1, "P2": 2}


class BridgeError(Exception):
    """A file/configuration error that should end the run with status 1."""


class BridgeConfigError(BridgeError):
    """Invalid command-line paths or state directory."""


def open_ro(path):
    """Open a SQLite database strictly read-only."""
    con = sqlite3.connect(
        "file:%s?mode=ro" % pathlib.Path(path).as_posix(), uri=True, timeout=5
    )
    con.row_factory = sqlite3.Row
    return con


def _as_utc(value):
    if value is None:
        return datetime.now(UTC)
    if value.tzinfo is None:
        return value.replace(tzinfo=UTC)
    return value.astimezone(UTC)


def _utc_iso(value):
    return _as_utc(value).isoformat(timespec="seconds")


def local8_to_utc_iso(value, now_utc=None):
    """Convert Horizon's +08:00 naive timestamp to a UTC ISO string.

    Bad or missing timestamps fall back to the current UTC time, as Horizon's
    own data is allowed to contain incomplete rows.
    """
    try:
        parsed = datetime.strptime(str(value), "%Y-%m-%d %H:%M:%S")
        return parsed.replace(tzinfo=LOCAL8).astimezone(UTC).isoformat(
            timespec="seconds"
        )
    except (TypeError, ValueError, OverflowError):
        return _utc_iso(now_utc)


def _row_get(row, key, default=None):
    try:
        return row[key]
    except (KeyError, IndexError, TypeError):
        return default


def _normalize_text(value):
    if value is None:
        return ""
    text = value if isinstance(value, str) else str(value)
    return text.replace("\r\n", "\n").strip()[:MAX_TEXT]


def _text_hash(text):
    return hashlib.sha1(text.encode("utf-8")).hexdigest()[:8]


def _idea_event_id(inbox_id):
    return hashlib.sha1(("horizon-idea:" + inbox_id).encode("utf-8")).hexdigest()[:32]


def _drop_event_id(inbox_id):
    return hashlib.sha1(("horizon-drop:" + inbox_id).encode("utf-8")).hexdigest()[:32]


def _edit_event_id(inbox_id, text):
    raw = "horizon-edit:" + inbox_id + ":" + _text_hash(text)
    return hashlib.sha1(raw.encode("utf-8")).hexdigest()[:32]


def read_state(events_path):
    """Read an event log and return (emitted idea_id -> last text, dropped ids)."""
    emitted = {}
    dropped = set()
    path = pathlib.Path(events_path)
    if not path.exists():
        return emitted, dropped

    with path.open("rb") as stream:
        for raw_line in stream:
            line = raw_line.decode("utf-8-sig", errors="replace").strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if not isinstance(event, dict):
                continue
            kind = event.get("type")
            idea_id = event.get("idea_id")
            if not isinstance(idea_id, str) or not idea_id:
                continue
            if kind == "idea":
                emitted[idea_id] = str(event.get("text") or "")
                dropped.discard(idea_id)
            elif kind == "idea_edit":
                emitted[idea_id] = str(event.get("text") or "")
            elif kind == "idea_drop":
                dropped.add(idea_id)
    return emitted, dropped


def plan_events(rows_by_id, emitted, dropped, now_utc):
    """Plan at most 200 new idea / idea_drop / idea_edit events."""
    now = _as_utc(now_utc)
    rows = {}
    for key, row in (rows_by_id or {}).items():
        rows[str(key)] = row
    emitted = {str(key): str(value) for key, value in (emitted or {}).items()}
    dropped = {str(value) for value in (dropped or set())}
    events = []

    candidates = []
    for inbox_id, row in rows.items():
        status = _row_get(row, "parse_status")
        if status not in ("received", "failed"):
            continue
        text = _normalize_text(_row_get(row, "raw_text"))
        if not text:
            continue
        idea_id = "horizon-" + inbox_id
        if idea_id in emitted:
            continue
        created = _row_get(row, "created_at")
        candidates.append((str(created) if created is not None else "", inbox_id, text))

    candidates.sort(key=lambda item: (item[0], item[1]))
    for _created, inbox_id, text in candidates:
        if len(events) >= MAX_EVENTS:
            break
        idea_id = "horizon-" + inbox_id
        events.append(
            {
                "id": _idea_event_id(inbox_id),
                "ts": local8_to_utc_iso(_row_get(rows[inbox_id], "created_at"), now),
                "host": "horizon",
                "type": "idea",
                "idea_id": idea_id,
                "text": text,
                "via": "horizon",
                "source": {
                    "app": "horizon-inbox",
                    "msg": str(_row_get(rows[inbox_id], "source_msg_id") or ""),
                },
            }
        )

    for idea_id in sorted(emitted):
        if len(events) >= MAX_EVENTS:
            break
        if idea_id in dropped or not idea_id.startswith("horizon-"):
            continue
        inbox_id = idea_id[len("horizon-") :]
        row = rows.get(inbox_id)
        if row is None:
            events.append(
                {
                    "id": _drop_event_id(inbox_id),
                    "ts": _utc_iso(now),
                    "host": "horizon",
                    "type": "idea_drop",
                    "idea_id": idea_id,
                    "reason": "deleted",
                }
            )
            continue

        status = _row_get(row, "parse_status")
        if status == "parsed":
            events.append(
                {
                    "id": _drop_event_id(inbox_id),
                    "ts": _utc_iso(now),
                    "host": "horizon",
                    "type": "idea_drop",
                    "idea_id": idea_id,
                    "reason": "todo",
                }
            )
        elif status in ("received", "failed"):
            new_text = _normalize_text(_row_get(row, "raw_text"))
            if new_text != emitted.get(idea_id, ""):
                events.append(
                    {
                        "id": _edit_event_id(inbox_id, new_text),
                        "ts": _utc_iso(now),
                        "host": "horizon",
                        "type": "idea_edit",
                        "idea_id": idea_id,
                        "text": new_text,
                    }
                )

    return events


def build_today(todo_rows, now_utc):
    """Build the horizon-today.json payload from todo rows."""
    now = _as_utc(now_utc)
    today_str = (now + timedelta(hours=8)).strftime("%Y-%m-%d")
    items = []

    for row in todo_rows or []:
        if _row_get(row, "status") not in ACTIVE_STATUSES:
            continue
        if _row_get(row, "parent_id") is not None:
            continue

        due_date = _row_get(row, "due_date")
        if due_date is not None:
            due_date = str(due_date)
        priority = _row_get(row, "priority")
        priority = "P1" if priority is None else str(priority)

        if due_date and due_date < today_str:
            flag = "overdue"
        elif due_date == today_str:
            flag = "today"
        elif not due_date and priority == "P0":
            flag = "p0_floating"
        else:
            continue

        due_time = _row_get(row, "due_time")
        if due_time is not None:
            due_time = str(due_time)
        items.append(
            {
                "id": str(_row_get(row, "id") or ""),
                "title": str(_row_get(row, "title") or ""),
                "priority": priority,
                "due_date": due_date,
                "due_time": due_time,
                "status": str(_row_get(row, "status") or ""),
                "flag": flag,
                "source": str(_row_get(row, "source") or ""),
            }
        )

    items.sort(
        key=lambda item: (
            FLAG_RANK[item["flag"]],
            item["due_time"] if item["due_time"] else "99:99",
            PRIORITY_RANK.get(item["priority"], 99),
        )
    )
    counts = {"overdue": 0, "today": 0, "p0_floating": 0}
    for item in items:
        counts[item["flag"]] += 1

    return {
        "version": 1,
        "generated_at": _utc_iso(now),
        "date": today_str,
        "counts": counts,
        "items": items,
    }


def write_events(path, events):
    """Append events in one write, with no BOM and a trailing newline each."""
    if not events:
        return
    payload = "".join(
        json.dumps(event, ensure_ascii=False) + "\n" for event in events
    )
    with open(path, "ab") as stream:
        stream.write(payload.encode("utf-8"))
        stream.flush()
        os.fsync(stream.fileno())


def _read_database(db_path):
    con = open_ro(db_path)
    try:
        inbox_rows = con.execute(
            "SELECT id, source_msg_id, raw_text, media_refs, parsed_json, "
            "parse_status, created_at FROM inbox"
        ).fetchall()
        columns = {
            row["name"] for row in con.execute("PRAGMA table_info(todos)").fetchall()
        }
        due_time_expr = "due_time" if "due_time" in columns else "NULL AS due_time"
        todo_rows = con.execute(
            "SELECT id, title, status, priority, due_date, source, parent_id, "
            "%s FROM todos" % due_time_expr
        ).fetchall()
        return inbox_rows, todo_rows
    finally:
        con.close()


@contextlib.contextmanager
def _state_lock(state_dir):
    """Yield True when locked; on Windows (no fcntl) always yield True."""
    if fcntl is None:
        yield True
        return

    lock_path = pathlib.Path(state_dir) / "lock"
    descriptor = os.open(str(lock_path), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            yield False
            return
        yield True
    finally:
        os.close(descriptor)


def _rotate_log(state_dir):
    log_path = pathlib.Path(state_dir) / "bridge.log"
    if log_path.exists() and log_path.stat().st_size > LOG_MAX_BYTES:
        with open(log_path, "w", encoding="utf-8", newline="\n"):
            pass


def _log(state_dir, message):
    if state_dir is None:
        return
    line = "%s %s\n" % (_utc_iso(datetime.now(UTC)), message)
    try:
        with open(
            pathlib.Path(state_dir) / "bridge.log",
            "a",
            encoding="utf-8",
            newline="\n",
        ) as stream:
            stream.write(line)
    except OSError:
        # Logging must never turn a successful bridge run into a failure.
        pass


def _skip_result(reason, state_dir=None):
    message = "skip: " + reason
    _log(state_dir, message)
    print(message)
    return {
        "idea": 0,
        "drop": 0,
        "edit": 0,
        "today": "skipped",
        "skipped": reason,
    }


def _needs_today_write(path, data):
    path = pathlib.Path(path)
    try:
        with path.open("r", encoding="utf-8") as stream:
            existing = json.load(stream)
    except (OSError, ValueError):
        return True
    if not isinstance(existing, dict):
        return True
    if (
        existing.get("date") != data["date"]
        or existing.get("counts") != data["counts"]
        or existing.get("items") != data["items"]
    ):
        return True
    try:
        age = time.time() - path.stat().st_mtime
    except OSError:
        return True
    return age > TODAY_REFRESH_SECONDS


def _write_today(path, data):
    path = pathlib.Path(path)
    temporary = pathlib.Path(str(path) + ".tmp")
    try:
        with open(temporary, "w", encoding="utf-8", newline="\n") as stream:
            stream.write(json.dumps(data, ensure_ascii=False, indent=2))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(str(temporary), str(path))
    finally:
        try:
            if temporary.exists():
                temporary.unlink()
        except OSError:
            pass


def _summarize(counts, today_state):
    return "idea +%d drop +%d edit +%d today=%s" % (
        counts["idea"],
        counts["drop"],
        counts["edit"],
        today_state,
    )


def run(db, events_dir, state_dir, dry_run=False, now_utc=None, verbose=False):
    """Run one bridge pass.  Returns the documented result dictionary."""
    events_path = pathlib.Path(events_dir).expanduser() / EVENTS_NAME
    today_path = pathlib.Path(events_dir).expanduser() / TODAY_NAME
    state_path = pathlib.Path(state_dir).expanduser()
    db_path = pathlib.Path(db).expanduser()
    now = _as_utc(now_utc)
    result = {
        "idea": 0,
        "drop": 0,
        "edit": 0,
        "today": "skipped",
        "skipped": None,
    }

    if not pathlib.Path(events_dir).expanduser().is_dir():
        raise BridgeConfigError("events-dir does not exist: %s" % events_dir)

    if dry_run:
        if not db_path.is_file():
            return _skip_result("database not found: %s" % db_path)
        try:
            inbox_rows, todo_rows = _read_database(db_path)
        except (sqlite3.Error, OSError) as exc:
            return _skip_result("database unavailable: %s" % exc)
        rows_by_id = {str(row["id"]): row for row in inbox_rows}
        emitted, dropped = read_state(events_path)
        events = plan_events(rows_by_id, emitted, dropped, now)
        today = build_today(todo_rows, now)
        for event in events:
            print(json.dumps(event, ensure_ascii=False))
            kind = event["type"]
            if kind == "idea":
                result["idea"] += 1
            elif kind == "idea_drop":
                result["drop"] += 1
            elif kind == "idea_edit":
                result["edit"] += 1
        today_summary = {
            "date": today["date"],
            "counts": today["counts"],
            "items": len(today["items"]),
        }
        print("today: " + json.dumps(today_summary, ensure_ascii=False))
        print(
            "dry-run: idea +%d drop +%d edit +%d"
            % (result["idea"], result["drop"], result["edit"])
        )
        return result

    try:
        state_path.mkdir(parents=True, exist_ok=True)
        _rotate_log(state_path)
    except OSError as exc:
        raise BridgeConfigError("cannot prepare state-dir: %s" % exc) from exc

    with _state_lock(state_path) as acquired:
        if not acquired:
            return _skip_result("another run is in progress", state_path)

        if not db_path.is_file():
            return _skip_result("database not found: %s" % db_path, state_path)

        try:
            inbox_rows, todo_rows = _read_database(db_path)
        except (sqlite3.Error, OSError) as exc:
            return _skip_result("database unavailable: %s" % exc, state_path)

        rows_by_id = {str(row["id"]): row for row in inbox_rows}
        emitted, dropped = read_state(events_path)
        events = plan_events(rows_by_id, emitted, dropped, now)
        for event in events:
            kind = event["type"]
            if kind == "idea":
                result["idea"] += 1
            elif kind == "idea_drop":
                result["drop"] += 1
            elif kind == "idea_edit":
                result["edit"] += 1

        try:
            write_events(events_path, events)
            today = build_today(todo_rows, now)
            if _needs_today_write(today_path, today):
                _write_today(today_path, today)
                result["today"] = "updated"
            else:
                result["today"] = "unchanged"
        except OSError as exc:
            _log(state_path, "error: %s" % exc)
            raise BridgeError("cannot write output: %s" % exc) from exc

        if verbose:
            for event in events:
                line = json.dumps(event, ensure_ascii=False)
                print(line)
                _log(state_path, line)
        summary = _summarize(result, result["today"])
        _log(state_path, summary)
        print(summary)
        return result


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Append Horizon inbox ideas to the shared event bus (read-only)."
    )
    parser.add_argument("--once", action="store_true", help="run one pass and exit")
    parser.add_argument("--dry-run", action="store_true", help="write nothing, show what would happen")
    parser.add_argument("--db", default=os.environ.get("HORIZON_DB", DEFAULT_DB))
    parser.add_argument(
        "--events-dir", default=os.environ.get("AGENT_HOME_DIR", DEFAULT_EVENTS_DIR)
    )
    parser.add_argument("--state-dir", default=DEFAULT_STATE_DIR)
    parser.add_argument("--verbose", action="store_true")
    args = parser.parse_args(argv)

    try:
        result = run(
            args.db,
            args.events_dir,
            args.state_dir,
            dry_run=args.dry_run,
            verbose=args.verbose,
        )
    except BridgeConfigError as exc:
        print("error: %s" % exc, file=sys.stderr)
        return 1
    except BridgeError as exc:
        print("error: %s" % exc, file=sys.stderr)
        return 1
    except Exception as exc:  # Never leak a traceback from a timer job.
        print("error: %s" % exc, file=sys.stderr)
        return 1

    # Missing/locked databases and a concurrent run are reported as skip and
    # intentionally exit 0 so the systemd timer does not raise an alarm.
    return 0


if __name__ == "__main__":
    sys.exit(main())
